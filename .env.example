# --- 서버 ---
PORT=3000
NODE_ENV=development

# 단일 사용자 인증 비밀번호 (반드시 변경)
PBG_AUTH_PASSWORD=change_me

# 세션 서명 시크릿 (긴 랜덤 문자열로 변경)
PBG_SESSION_SECRET=please_change_this_to_a_long_random_string

# --- 경로 (컨테이너 기준) ---
# 편집(재압축) 시 원본을 보관할 백업 경로
PBG_BACKUP_DIR=./backups

# 썸네일 캐시 경로
PBG_CACHE_DIR=./cache

# --- 데이터베이스 (Prisma / SQLite) ---
DATABASE_URL="file:./data/pbg.db"
