# --- 서버 ---
PORT=3000
NODE_ENV=development

# 단일 사용자 인증 비밀번호 (반드시 변경)
PBG_AUTH_PASSWORD=change_me

# 세션 서명 시크릿 (긴 랜덤 문자열로 변경)
PBG_SESSION_SECRET=please_change_this_to_a_long_random_string

# --- 경로 (컨테이너 기준) ---
# 편집(재압축) 시 원본을 보관할 백업 경로
PBG_BACKUP_DIR=./backups

# 썸네일 캐시 경로
PBG_CACHE_DIR=./cache

# 썸네일 캐시 한계(MB). 초과 시 가장 오래 안 쓴 파일부터 자동 제거. 기본 2048.
PBG_CACHE_MAX_MB=2048

# 캐시 GC 주기(분). 부팅 시 1회 + 이 주기마다 실행. 기본 30.
PBG_CACHE_GC_INTERVAL_MIN=30

# --- 데이터베이스 (Prisma / SQLite) ---
DATABASE_URL="file:./data/pbg.db"

# --- 작업 큐 (BullMQ / Redis) ---
# 배경 작업(인덱싱·재압축·자동 태깅·중복 탐지)을 Redis 큐로 직렬화.
# docker-compose 사용 시 redis 서비스가 자동으로 기동됨. 로컬 개발은:
#   docker run -d -p 6379:6379 --name pbg-redis redis:7-alpine
REDIS_URL="redis://localhost:6379"
