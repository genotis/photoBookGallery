// photoBookGallery 도메인 스키마
// 식별 기준 = contentHash(내용 전체 해시). 파일이 단일 진실 원천, DB는 인덱스/메타.
// 자세한 설계: docs/05-data-model.md

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // Alpine(musl) + OpenSSL 3 환경에 맞는 query engine 추가.
  // "native" 는 로컬 개발(mac/glibc) 용.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model LibraryRoot {
  id            Int            @id @default(autoincrement())
  path          String         @unique // NAS 절대경로 (컨테이너 기준)
  label         String?
  readOnly      Boolean        @default(false) // 편집 허용 여부
  scanCron      String? // 자동 스캔 cron 식 (예: "0 3 * * *"). null 이면 수동.
  archives      Archive[]
  classifyRules ClassifyRule[]
  createdAt     DateTime       @default(now())
}

// 파일명 패턴 기반 분류 규칙.
// 매칭된 아카이브를 destTemplate 이 산출한 (루트 상대) 하위경로로 물리 이동하고
// DB path 를 갱신한다. 우선순위(priority) 오름차순으로 평가, 첫 매칭 규칙만 적용.
model ClassifyRule {
  id           Int          @id @default(autoincrement())
  name         String
  priority     Int          @default(0) // 낮을수록 먼저 평가 (우선순위 첫 매칭)
  enabled      Boolean      @default(true) // 규칙 자체 사용 여부
  rootId       Int? // null = 모든 루트 대상. 지정 시 해당 루트의 아카이브만.
  root         LibraryRoot? @relation(fields: [rootId], references: [id], onDelete: Cascade)
  matchType    String       @default("regex") // regex | glob (파일명 기준)
  pattern      String // 파일명 매칭 패턴
  // 태깅 액션 — JSON 배열. 각 항목 { target, source, key?, value? }.
  // target: country|model|publisher|series|title|tag, source: group|literal.
  assignments  String? // null/[] 이면 태깅 없음
  destTemplate String       @default("") // 대상 하위경로 템플릿 (루트 상대). 빈값이면 이동 안 함(태깅만).
  scanCron     String? // 규칙별 cron 식. null 이면 스케줄 없음.
  scheduleOn   Boolean      @default(false) // 스케줄 온/오프 토글
  batchLimit   Int? // 한 실행에서 이동할 최대 건수. null 이면 무제한. 나머지는 다음 실행에서.
  lastRunAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([priority])
  @@index([rootId])
}

// 분류 이동 이력 — 원복(undo) 가능하도록 각 이동을 기록.
// 규칙/잡이 삭제돼도 이력이 남도록 이름은 스냅샷으로 보관하고 FK 는 두지 않는다.
// 식별은 contentHash(내용 불변) 기준 — 이동/원복 후에도 아카이브를 다시 찾을 수 있다.
model ClassifyMove {
  id          Int       @id @default(autoincrement())
  archiveId   Int // 이동 당시 아카이브 id (참조용)
  contentHash String // 안정 식별자 (이동은 내용 불변)
  fileName    String
  fromPath    String // 이동 전 절대경로
  toPath      String // 이동 후 절대경로
  jobId       Int? // 이 이동을 만든 apply job
  ruleId      Int? // 적용된 규칙 (삭제될 수 있음)
  ruleName    String? // 규칙 이름 스냅샷
  status      String    @default("moved") // moved | reverted
  createdAt   DateTime  @default(now())
  revertedAt  DateTime?

  @@index([jobId])
  @@index([archiveId])
  @@index([status])
  @@index([createdAt])
}

model Archive {
  id          Int          @id @default(autoincrement())
  rootId      Int
  root        LibraryRoot  @relation(fields: [rootId], references: [id])
  path        String       @unique // 현재 파일 경로 (이동 시 갱신됨)
  fileName    String
  format      String // zip | cbz | rar | cbr | 7z
  sizeBytes   BigInt
  mtime       DateTime // 원본 수정시각 (해시/캐시 무효화 키)
  contentHash String       @unique // 식별 기준 (BLAKE3/xxHash64 전체 해시)
  pageCount   Int          @default(0)
  coverEntry  String? // 표지로 쓸 엔트리 이름
  title       String? // 사진집 제목 (파일명과 별개, 파서/사용자가 채움)

  // 분류
  countryId   Int?
  country     Country?     @relation(fields: [countryId], references: [id])
  publisherId Int?
  publisher   Publisher?   @relation(fields: [publisherId], references: [id])
  seriesId    Int?
  series      Series?      @relation(fields: [seriesId], references: [id])
  models      ArchiveModel[]
  tags        ArchiveTag[]
  entries     Entry[]

  // 사용자 메타
  publishedAt DateTime?
  rating      Int? // 0~5
  favorite    Boolean      @default(false)
  note        String?

  // 상태
  indexedAt   DateTime?
  missing     Boolean      @default(false) // 원본이 사라졌는지
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([countryId])
  @@index([publisherId])
  @@index([seriesId])
  @@index([favorite])
  @@index([rating])
  @@index([mtime])
  @@index([contentHash])
}

model Entry {
  id        Int      @id @default(autoincrement())
  archiveId Int
  archive   Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  name      String // 압축 내 엔트리 경로
  order     Int // 자연정렬 후 페이지 순서
  sizeBytes BigInt?
  width     Int?
  height    Int?
  isImage   Boolean  @default(true)

  // 직독(offset-based) 로딩용 ZIP 위치 정보 — 스캔 때 채운다.
  // null 이면(RAR·재색인 전 데이터) 압축 라이브러리 경로로 폴백.
  method    Int? // ZIP 압축 방식: 0=Store(무압축), 8=Deflate
  locOffset BigInt? // 로컬 파일 헤더 오프셋
  compSize  BigInt? // 압축 크기(Deflate 슬라이스 길이; Store 면 size 와 동일)

  @@unique([archiveId, name])
  @@index([archiveId, order])
}

model Model {
  id         Int            @id @default(autoincrement())
  name       String         @unique // 원문/대표 이름 (매칭·식별 기준)
  nameEn     String? // 영문(로마자) 이름 — 모델 목록 정렬·표시에 우선 사용
  aliases    String? // JSON 배열 문자열 (별칭/표기 변형)
  profileImg String?
  bio        String?
  favorite   Boolean        @default(false) // 모델 즐겨찾기
  archives   ArchiveModel[]
  createdAt  DateTime       @default(now())

  @@index([favorite])
}

model ArchiveModel {
  archiveId Int
  modelId   Int
  archive   Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  model     Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([archiveId, modelId])
  @@index([modelId])
}

model Publisher {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  kind     String? // 잡지사 | 스튜디오 | 개인 등
  archives Archive[]
}

model Country {
  id       Int       @id @default(autoincrement())
  code     String    @unique // JP, KR, ...
  name     String
  archives Archive[]
}

model Series {
  id       Int       @id @default(autoincrement())
  name     String
  archives Archive[]
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  archives ArchiveTag[]
}

model ArchiveTag {
  archiveId Int
  tagId     Int
  archive   Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([archiveId, tagId])
  @@index([tagId])
}

// 렌더 제외 규칙 — 파일명 패턴에 매칭되는 압축 내 이미지를 뷰어/페이지에서 숨긴다.
// 광고 이미지처럼 여러 책에 반복 등장하는 파일을 전역으로 미표시하는 용도.
// 물리 삭제가 아니라 표시만 제외 — 원본 파일은 그대로 둔다.
model RenderExclusion {
  id        Int      @id @default(autoincrement())
  matchType String   @default("glob") // glob | regex (엔트리 basename 기준)
  pattern   String
  enabled   Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
}

model Job {
  id        Int      @id @default(autoincrement())
  type      String // index | thumbnail | repack
  status    String   @default("pending") // pending | running | done | failed
  payload   String // JSON
  progress  Float    @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
}
